# Platform
ADMIN_SECRET=generate-a-long-admin-secret-here

# Optional platform-wide Heroku API key (apps can override)
HEROKU_API_KEY=

# Public base URL for webhook links in the dashboard
APP_BASE_URL=http://localhost:3000

# Database (Neon via Vercel integration)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional internal Slack ops alerts (omit either value to disable)
# SLACK_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=C0123456789

# Logging
LOG_LEVEL=info
# WEBHOOK_DEBUG=true

# Legacy seed (optional — used by npm run db:seed to import a single app)
# TARGET_HEROKU_APP=cartmagician
# WEBHOOK_SECRET=your-existing-webhook-secret
# MIN_DYNOS=1
# MAX_DYNOS=10
# RESPONSE_TIME_THRESHOLD_MS=2000
# MEMORY_THRESHOLD_PERCENT=85
# SCALE_UP_COOLDOWN_SECONDS=300
# SCALE_DOWN_COOLDOWN_SECONDS=600
