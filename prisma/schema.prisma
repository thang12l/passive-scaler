generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  slug                     String   @id
  appName                  String   @unique @map("app_name")
  displayName              String   @map("display_name")
  webhookSecretHash        String   @map("webhook_secret_hash")
  scalingEnabled           Boolean  @default(false) @map("scaling_enabled")
  minDynos                 Int      @default(1) @map("min_dynos")
  maxDynos                 Int      @default(10) @map("max_dynos")
  responseTimeThresholdMs  Int      @default(2000) @map("response_time_threshold_ms")
  memoryThresholdPercent   Decimal  @default(85) @map("memory_threshold_percent") @db.Decimal(5, 2)
  scaleUpCooldownSeconds   Int      @default(300) @map("scale_up_cooldown_seconds")
  scaleDownCooldownSeconds Int      @default(600) @map("scale_down_cooldown_seconds")
  herokuApiKey             String?  @map("heroku_api_key")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  scalingState ScalingState?
  events       ScalingEvent[]

  @@index([appName])
  @@map("apps")
}

model ScalingState {
  id                Int       @id @default(autoincrement())
  appSlug           String    @unique @map("app_slug")
  lastScaleTime     DateTime? @map("last_scale_time")
  lastAction        String?   @map("last_action")
  currentDynos      Int?      @map("current_dynos")
  lastResponseTime  Decimal?  @map("last_response_time") @db.Decimal(10, 2)
  lastMemoryPercent Decimal?  @map("last_memory_percent") @db.Decimal(5, 2)
  scalingInProgress Boolean   @default(false) @map("scaling_in_progress")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  app App @relation(fields: [appSlug], references: [slug], onDelete: Cascade)

  @@index([appSlug])
  @@map("scaling_state")
}

model ScalingEvent {
  id          Int      @id @default(autoincrement())
  appSlug     String   @map("app_slug")
  action      String
  reason      String
  metricsJson Json     @map("metrics_json")
  createdAt   DateTime @default(now()) @map("created_at")
  app         App      @relation(fields: [appSlug], references: [slug], onDelete: Cascade)

  @@index([appSlug])
  @@index([createdAt])
  @@map("scaling_events")
}
