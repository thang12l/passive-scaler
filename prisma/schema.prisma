generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  slug                           String   @id
  appName                        String   @unique @map("app_name")
  displayName                    String   @map("display_name")
  webhookSecretHash              String   @map("webhook_secret_hash")
  scalingEnabled                 Boolean  @default(false) @map("scaling_enabled")
  minDynos                       Int      @default(1) @map("min_dynos")
  maxDynos                       Int      @default(10) @map("max_dynos")
  responseTimeThresholdMs        Int      @default(2000) @map("response_time_threshold_ms")
  memoryThresholdPercent         Decimal  @default(85) @map("memory_threshold_percent") @db.Decimal(5, 2)
  scaleUpCooldownSeconds         Int      @default(300) @map("scale_up_cooldown_seconds")
  scaleDownCooldownSeconds       Int      @default(600) @map("scale_down_cooldown_seconds")
  workerScalingEnabled           Boolean  @default(false) @map("worker_scaling_enabled")
  workerMinDynos                 Int      @default(1) @map("worker_min_dynos")
  workerMaxDynos                 Int      @default(5) @map("worker_max_dynos")
  workerQueueSizeThreshold       Int      @default(10) @map("worker_queue_size_threshold")
  workerQueueLatencyThresholdMs  Int      @default(5000) @map("worker_queue_latency_threshold_ms")
  workerMemoryThresholdPercent   Decimal  @default(85) @map("worker_memory_threshold_percent") @db.Decimal(5, 2)
  workerScaleUpCooldownSeconds   Int      @default(300) @map("worker_scale_up_cooldown_seconds")
  workerScaleDownCooldownSeconds Int      @default(600) @map("worker_scale_down_cooldown_seconds")
  herokuApiKey                   String?  @map("heroku_api_key")
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  formations FormationState[]
  events     ScalingEvent[]

  @@index([appName])
  @@map("apps")
}

model FormationState {
  id                Int       @id @default(autoincrement())
  appSlug           String    @map("app_slug")
  processType       String    @map("process_type")
  lastScaleTime     DateTime? @map("last_scale_time")
  lastAction        String?   @map("last_action")
  currentDynos      Int?      @map("current_dynos")
  lastResponseTime  Decimal?  @map("last_response_time") @db.Decimal(10, 2)
  lastMemoryPercent Decimal?  @map("last_memory_percent") @db.Decimal(5, 2)
  lastQueueSize     Int?      @map("last_queue_size")
  lastQueueLatency  Decimal?  @map("last_queue_latency") @db.Decimal(10, 2)
  scalingInProgress Boolean   @default(false) @map("scaling_in_progress")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  app App @relation(fields: [appSlug], references: [slug], onDelete: Cascade)

  @@unique([appSlug, processType])
  @@index([appSlug])
  @@map("formation_state")
}

model ScalingEvent {
  id          Int      @id @default(autoincrement())
  appSlug     String   @map("app_slug")
  processType String   @map("process_type")
  action      String
  reason      String
  metricsJson Json     @map("metrics_json")
  createdAt   DateTime @default(now()) @map("created_at")
  app         App      @relation(fields: [appSlug], references: [slug], onDelete: Cascade)

  @@index([appSlug])
  @@index([appSlug, processType])
  @@index([createdAt])
  @@map("scaling_events")
}
